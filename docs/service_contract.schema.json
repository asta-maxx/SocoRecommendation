    "IngestRequest": {
      "additionalProperties": false,
      "description": "The request body of POST /v1/events, fully typed.\n\nThis is the shape SOCO_BE builds and the schema it validates against. The server\nparses the envelope and each event separately -- see `parse_batch` -- so one\nmalformed impression does not throw away an order in the same batch.",
      "properties": {
        "contract_version": {
          "const": "1.0",
          "title": "Contract Version",
          "type": "string"
        },
        "events": {
          "items": {
            "discriminator": {
              "mapping": {
                "add_to_cart": "#/$defs/AddToCartEvent",
                "commission_state_changed": "#/$defs/CommissionStateChangedEvent",
                "identity_stitched": "#/$defs/IdentityStitchedEvent",
                "opportunity_state_changed": "#/$defs/OpportunityStateChangedEvent",
                "order_placed": "#/$defs/OrderPlacedEvent",
                "order_state_changed": "#/$defs/OrderStateChangedEvent",
                "payment_state_changed": "#/$defs/PaymentStateChangedEvent",
                "recommendation_click": "#/$defs/RecommendationClickEvent",
                "recommendation_impression": "#/$defs/RecommendationImpressionEvent",
                "recommendation_request": "#/$defs/RecommendationRequestEvent",
                "search_performed": "#/$defs/SearchPerformedEvent",
                "social_interaction": "#/$defs/SocialInteractionEvent"
              },
              "propertyName": "event_name"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/RecommendationRequestEvent"
              },
              {
                "$ref": "#/$defs/RecommendationImpressionEvent"
              },
              {
                "$ref": "#/$defs/RecommendationClickEvent"
              },
              {
                "$ref": "#/$defs/AddToCartEvent"
              },
              {
                "$ref": "#/$defs/OrderPlacedEvent"
              },
              {
                "$ref": "#/$defs/OrderStateChangedEvent"
              },
              {
                "$ref": "#/$defs/PaymentStateChangedEvent"
              },
              {
                "$ref": "#/$defs/CommissionStateChangedEvent"
              },
              {
                "$ref": "#/$defs/SocialInteractionEvent"
              },
              {
                "$ref": "#/$defs/OpportunityStateChangedEvent"
              },
              {
                "$ref": "#/$defs/SearchPerformedEvent"
              },
              {
                "$ref": "#/$defs/IdentityStitchedEvent"
              }
            ]
          },
          "maxItems": 500,
          "minItems": 1,
          "title": "Events",
          "type": "array"
        },
        "sent_at": {
          "format": "date-time",
          "title": "Sent At",
          "type": "string"
        }
      },
      "required": [
        "contract_version",
        "sent_at",
        "events"
      ],
      "title": "IngestRequest",
      "type": "object"
    },
    "IngestResponse": {
      "additionalProperties": false,
      "description": "202 Accepted -- the envelope was valid, whatever happened to each event.\n\n`accepted` means STORED, not that the event will score. A short impression or\nan order state M1 does not read is accepted, then ignored or dropped and counted\nby the reader.\n\n`accepted + duplicates + len(rejected)` always equals the number sent.",
      "properties": {
        "accepted": {
          "minimum": 0,
          "title": "Accepted",
          "type": "integer"
        },
        "contract_version": {
          "const": "1.0",
          "title": "Contract Version",
          "type": "string"
        },
        "duplicates": {
          "minimum": 0,
          "title": "Duplicates",
          "type": "integer"
        },
        "received_at": {
          "format": "date-time",
          "title": "Received At",
          "type": "string"
        },
        "rejected": {
          "items": {
            "$ref": "#/$defs/RejectedEvent"
          },
          "title": "Rejected",
          "type": "array"
        }
      },
      "required": [
        "contract_version",
        "received_at",
        "accepted",
        "duplicates",
        "rejected"
      ],
      "title": "IngestResponse",
      "type": "object"
    },
    "ItemType": {
      "description": "F10. What an item is.\n\nThe register lists \"product, promotion, promoter or brand\" in F10 and \"product,\npost, promoter or brand\" in F32. Feed items are posts, so both lists are taken\ntogether rather than one silently chosen.",
      "enum": [
        "post",
        "product",
        "promotion",
        "promoter",
        "brand"
      ],
      "title": "ItemType",
      "type": "string"
    },
