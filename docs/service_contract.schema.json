          "type": "integer"
        },
        "request_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Request Id"
        },
        "user_id": {
          "minLength": 1,
          "title": "User Id",
          "type": "string"
        }
      },
      "required": [
