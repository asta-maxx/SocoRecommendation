    "RecommendationsResponse": {
      "additionalProperties": false,
      "description": "What the service returns. Budget 200 ms, then SOCO_BE serves the delivered\nordering under DELIVERED_POLICY_ID.\n\nThe client keeps `request_id` and `is_exploration` with the list and echoes\nthem on every event that follows from it (R1, R5). `policy_id` is the stamp for\nthe list (R3). It is not repeated on each event, because request_id joins\nevery event back to the recommendation_request that carries it.",
      "properties": {
        "contract_version": {
          "const": "1.0",
          "title": "Contract Version",
          "type": "string"
        },
        "is_exploration": {
          "title": "Is Exploration",
          "type": "boolean"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/RecommendedItem"
          },
          "title": "Items",
          "type": "array"
        },
        "personalised": {
          "title": "Personalised",
          "type": "boolean"
        },
        "policy_id": {
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "server_ts": {
          "format": "date-time",
          "title": "Server Ts",
          "type": "string"
        }
      },
      "required": [
        "contract_version",
        "request_id",
        "policy_id",
        "server_ts",
        "is_exploration",
        "personalised",
        "items"
      ],
      "title": "RecommendationsResponse",
      "type": "object"
    },
