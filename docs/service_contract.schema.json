    "OrderState": {
      "description": "F30. The values of order_status, the canonical field (Q06, PT-04).\n\nPending is the state an order is created in, so it arrives as order_placed.\nReturned and Refunded do not exist: D1 records a return as two fields on the\norder, with the status left unchanged.",
      "enum": [
        "Accepted",
        "Confirmed",
        "Shipped",
        "Delivered",
        "Cancelled",
        "Rejected"
      ],
      "title": "OrderState",
      "type": "string"
