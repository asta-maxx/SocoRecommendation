# Copy to .env and fill in. .env is gitignored; .env.example is committed.
#
# .env is for dev and test only. In production every value here is set in the
# server environment, and a .env file is not read (SD-08, ENG-01).

# --- Environment -------------------------------------------------------------
# dev | test | production (SD-04). Each has its own engine database.
ENGINE_ENV=dev

# --- MongoDB -----------------------------------------------------------------
# APP_MONGO_URI reads SOCO application collections. READ ONLY.
# In production this is the PT-01 credential. Add readPreference=secondaryPreferred
# so reading never competes with application writes.
APP_MONGO_URI=mongodb://localhost:27017/?readPreference=secondaryPreferred
# Case sensitive. The SOCO cluster's database is lowercase `soco`.
# A wrong case is not an error -- every read just returns nothing. The service
# warns about this at startup rather than letting it look like an idle user.
APP_MONGO_DB=soco

# ML_MONGO_URI writes ml_ collections. Must be a SEPARATE credential whose
# privileges are scoped to the ml_ prefix and nothing else (B5 / Q14 Option A).
# Locally these may point at the same server; in production they must not be
# the same user. See HANDOFF.md for the db.createUser command.
ML_MONGO_URI=mongodb://localhost:27017
# The engine's OWN database (AS-09, SD-06), one per environment. It is never the
# platform database: the service refuses to start if it is. Unset, it defaults
# to soco_engine_<ENGINE_ENV>.
ML_MONGO_DB=soco_engine_dev

# --- Source and target collections --------------------------------------------
# DATA_PROFILE moves the whole pipeline between generated and live data. It is
# what removes the need for a demo branch -- the demonstration runs this same
# code, reading and writing different collections.
#
#   live  postevents / posts / registers / orders -> ml_user_interest_scores
#   demo  ml_demo_events / ml_demo_posts / ml_demo_users / ml_demo_orders
#                                                -> ml_user_interest_scores_demo
#
# FOUR sources, not two: Method A reads the declared floor from the user record
# and ages a purchase reversal from the order's creation, so the user and order
# sources have to move with the profile as well.
#
# Generated data lives under ml_ throughout, because the generator cannot write
# to an application collection. Reads follow the collection: an ml_ source is
# read through the ml connection, an application source through the read-only one.
DATA_PROFILE=live

# Optional. Override any single collection. A score target outside the ml_
# namespace is refused at startup.
# EVENTS_COLLECTION=
# POSTS_COLLECTION=
# USERS_COLLECTION=
# ORDERS_COLLECTION=
# SCORES_COLLECTION=

# How event documents carry their category. Defaulted from DATA_PROFILE; a name
# and a shape are independent facts, so this is overridable on its own.
#   flat       the categories array is on the event row
#   postevent  the row carries a post_id and the category resolves via the post
# EVENT_SHAPE=

# --- Model identity ----------------------------------------------------------
# Stamped onto every score. Part of the unique index, so changing it creates a
# new generation of scores rather than overwriting the old one. That is intended.
MODEL_VERSION=1.0.0

# --- Settings file -------------------------------------------------------------
# Every tunable value (weights, windows, thresholds) lives in ONE versioned file,
# never in environment variables (SD-07, ENG-02). Relative to the repo root.
SETTINGS_FILE=settings/engine.toml

# --- Tokens ------------------------------------------------------------------
# The serving token: SOCO_BE sends it as a bearer token on POST /v1/recommendations
# (DS-017 v2.5 section 3; POST /v1/events is retired). Generate one with
#   .venv/bin/python scripts/generate_ingest_token.py
# and give it to Aravinth privately. Never commit it. Empty = every call refused.
INGEST_TOKEN=

# --- Service -----------------------------------------------------------------
LOG_LEVEL=INFO
